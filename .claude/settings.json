{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/checkpoint.sh\"",
            "statusMessage": "Checkpointing...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
